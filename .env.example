# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017/industrial_fire_ai

# Machine Learning Service (FastAPI)
ML_SERVICE_URL=http://localhost:8000

# NASA FIRMS Integration (Optional - System defaults to DEMO MODE without keys)
FIRMS_API_KEY=
FIRMS_API_URL=https://firms.modaps.eosdis.nasa.gov/api/country/csv

# OpenStreetMap Context Intelligence
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Persistence Analysis Parameters
SPATIAL_TOLERANCE_KM=1.0
PERSISTENCE_MIN_DETECTIONS=2

# Risk Thresholds
RISK_HIGH_THRESHOLD=70
RISK_MEDIUM_THRESHOLD=40

# Frontend CORS
CORS_ORIGIN=http://localhost:5173
